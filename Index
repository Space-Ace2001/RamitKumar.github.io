.cols .tag{flex:none;place-items:center start;min-height:calc(2.6em + 16px);padding:8px 10px;background:var(--accent);color:#0b0b0f;font:700 10.5px/1.3 Archivo,"Helvetica Neue",Arial,sans-serif;font-stretch:125%;letter-spacing:.03em;text-align:left;text-transform:uppercase}
.cols .tag{align-content:center;padding:10px 10px 7px}
.cols{display:flex;flex-direction:column;gap:40px}
.cols>div{display:flex;flex-direction:column;align-items:center}
