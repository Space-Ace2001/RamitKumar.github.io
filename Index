document.querySelectorAll(".cols ul,.contact,.tri,.five,.quad,.duo,.shots").forEach(function(g){Array.prototype.forEach.call(g.children,function(c,i){c.style.transitionDelay=Math.min(i,6)*70+"ms"})});
if("IntersectionObserver" in window){
 var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){var t=e.target;t.classList.add("in");io.unobserve(t);runType(t);setTimeout(function(){t.style.transitionDelay=""},1400)}})},{threshold:.08,rootMargin:"0px 0px -6% 0px"});
 els.forEach(function(e){io.observe(e)});
 var links={};document.querySelectorAll("nav a").forEach(function(a){links[a.getAttribute("href")]=a});
 var so=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){for(var k in links)links[k].classList.remove("active");var l=links["#"+e.target.id];if(l)l.classList.add("active")}})},{rootMargin:"-35% 0px -60% 0px"});
 ["work","skills","contact"].forEach(function(id){var x=document.getElementById(id);if(x)so.observe(x)});
}else{els.forEach(function(e){e.classList.add("in");runType(e)})}
}
})();
</script>
</body>
</html>
