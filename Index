.contact li{grid-template-columns:52px 1fr;align-items:center}
.contact span.ci{display:grid;place-items:center;width:40px;height:40px;background:#a9aab9;color:#111114}
.contact span.ci svg{width:22px;height:22px;fill:currentColor}
.contact{display:flex;flex-wrap:wrap;gap:12px;max-width:none}
.contact li{display:block;flex:0 0 240px;padding:0;border:0}
.contact a.card{display:flex;flex-direction:column;height:100%;background:#a9aab9;color:#111114;text-decoration:none;transition:background .15s}
.contact a.card:hover{background:#c0c1cc;color:#111114;text-decoration:none}
.contact .ctile{display:grid;place-items:center;height:104px}
.contact .ctile svg{width:44px;height:44px;fill:currentColor}
.contact .ctag{flex:1;display:grid;align-content:center;padding:10px 10px 7px;min-height:58px;background:var(--accent);color:#0b0b0f;font:700 11px/1.35 Archivo,"Helvetica Neue",Arial,sans-serif;font-stretch:125%;letter-spacing:.02em;overflow-wrap:anywhere}
